# Fast_deploy_ceph cluster config. Copy to cluster.conf and edit EVERY value.
# Sourced by bash; keep the array syntax.

CEPH_VERSION="20.2.4"
BUNDLE_DIR="/opt/ceph-offline"          # where the bundle is extracted on every node

# Nodes: index 0 is the admin/bootstrap node (runs registry, chrony server, bootstrap).
# Names MUST equal `hostname -s` on each node.
NODE_NAMES=(node1 node2 node3)
NODE_IPS=(10.250.0.11 10.250.0.12 10.250.0.13)   # storage/public IP (e.g. on bond0)
PUBLIC_NETWORK="10.250.0.0/24"
CLUSTER_NETWORK=""                       # optional separate replication network, "" = same

# Local registry on node1, bound to NODE_IPS[0] only, plain HTTP (trusted as insecure).
REGISTRY_PORT=5000
# 1 = also `podman load` the ceph image on every node and tag it with the registry
#     name, so daemons can start even if the registry is down (fallback).
LOAD_IMAGE_ON_ALL_NODES=1

# Time: node1 serves time to the cluster (stratum 10 local clock unless UPSTREAM_NTP set).
UPSTREAM_NTP=""                          # e.g. "10.250.0.1" internal NTP; "" = node1 local clock
NTP_ALLOW="10.250.0.0/24"

# OSD devices, one entry per disk: "<host>:<stable path>". Use /dev/disk/by-id/...!
# These disks will be WIPED by add-osds.sh. Never use --all-available-devices.
OSD_DEVICES=(
  "node1:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N1D1"
  "node1:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N1D2"
  "node1:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N1D3"
  "node1:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N1D4"
  "node2:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N2D1"
  "node2:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N2D2"
  "node2:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N2D3"
  "node2:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N2D4"
  "node3:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N3D1"
  "node3:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N3D2"
  "node3:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N3D3"
  "node3:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N3D4"
)

# Replication (default 3/2: survives loss of one host). 2/1 possible but risky.
POOL_SIZE=3
POOL_MIN_SIZE=2

# --- Production VIP (cephadm ingress: haproxy + keepalived containers) ----------
# Placeholders — fill before ./setup-ingress-vip.sh --apply
VIP_ADDR="10.250.0.10"                   # floating VIP (no CIDR here)
VIP_CIDR="24"                            # combined as VIP_ADDR/VIP_CIDR in the spec
# Network used to pick the NIC for the VIP (usually same as PUBLIC_NETWORK)
VIP_INTERFACE_NETWORK="10.250.0.0/24"
VRRP_INTERFACE_NETWORK=""                # optional; "" = same NIC as VIP
# Ingress images tags (must match offline bundle / Tentacle 20.2.4 defaults)
HAPROXY_TAG="2.3"
KEEPALIVED_TAG="2.2.4"
# backend_service: "mon" for client/CSI-oriented VIP; "rgw.*" / "nfs.*" for those stacks
INGRESS_BACKEND_SERVICE="mon"
INGRESS_SERVICE_ID="mon"
INGRESS_FRONTEND_PORT=3300               # msgr2 when fronting mon; ignored if keepalive_only
INGRESS_MONITOR_PORT=1967                # haproxy stats; ignored if keepalive_only
# 1 = keepalived only (recommended for mon/CSI VIP on Tentacle: stock haproxy mode is HTTP
#     for non-nfs backends and is unsuitable for MON msgr2). 0 = full haproxy+keepalived
#     (use for RGW/NFS backends).
INGRESS_KEEPALIVE_ONLY=1

# CephFS (optional; primary path is RBD — see docs/cephfs-client.md)
FS_NAME="models"
META_POOL="models_meta"
DATA_POOL="models_data"
META_PG=32
DATA_PG=128
MDS_COUNT=2                               # 1 active + 1 standby
CLIENT_RO="modelreader"
CLIENT_RW="modelwriter"

# Extra (testing only): osd_memory_target in bytes, "" = Ceph default (4 GiB)
OSD_MEMORY_TARGET=""
