# Fast_deploy_ceph cluster config. Copy to cluster.conf and edit EVERY value.
# Sourced by bash; keep the array syntax.

CEPH_VERSION="20.2.4"
BUNDLE_DIR="/opt/ceph-offline"          # where the bundle is extracted on every node

# SSH from node1 to peers (BatchMode). Optional; leave commented for the default
# StrictHostKeyChecking=accept-new and OpenSSH's default known_hosts.
# Pinned-host-only (no AcceptNew): pin keys first, then uncomment:
#   mkdir -p /etc/fast-deploy
#   ssh-keyscan -t ed25519,rsa node2 node3 10.250.0.12 10.250.0.13 > /etc/fast-deploy/known_hosts
# SSH_STRICT_HOSTKEY=1                     # 1/yes/true = StrictHostKeyChecking=yes; 0/no/false = accept-new; other values = error
# SSH_KNOWN_HOSTS=/etc/fast-deploy/known_hosts   # UserKnownHostsFile
# SSH_CONNECT_TIMEOUT=8
# Precedence: an assignment here > exported environment variable > built-in default.
# (Use SSH_STRICT_HOSTKEY=${SSH_STRICT_HOSTKEY-1} here to let the environment override.)
# Note: sudo drops env by default -> `sudo SSH_STRICT_HOSTKEY=1 ./deploy.sh`.

# Nodes: index 0 is the admin/bootstrap node (runs registry, chrony server, bootstrap).
# Names MUST equal `hostname -s` on each node.
NODE_NAMES=(node1 node2 node3)
NODE_IPS=(10.250.0.11 10.250.0.12 10.250.0.13)   # storage/public IP (e.g. on bond0)
PUBLIC_NETWORK="10.250.0.0/24"
CLUSTER_NETWORK=""                       # optional separate replication network, "" = same

# Local registry on node1, bound to NODE_IPS[0] only, plain HTTP (trusted as insecure).
REGISTRY_PORT=5000
# 1 = also `podman load` the ceph image on every node and tag it with the registry
#     name, so daemons can start even if the registry is down (fallback).
LOAD_IMAGE_ON_ALL_NODES=1

# Time: node1 serves time to the cluster (stratum 10 local clock unless UPSTREAM_NTP set).
UPSTREAM_NTP=""                          # e.g. "10.250.0.1" internal NTP; "" = node1 local clock
NTP_ALLOW="10.250.0.0/24"

# OSD devices, one entry per disk: "<host>:<stable path>". Use /dev/disk/by-id/...!
# These disks will be WIPED by add-osds.sh. Never use --all-available-devices.
OSD_DEVICES=(
  "node1:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N1D1"
  "node1:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N1D2"
  "node1:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N1D3"
  "node1:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N1D4"
  "node2:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N2D1"
  "node2:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N2D2"
  "node2:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N2D3"
  "node2:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N2D4"
  "node3:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N3D1"
  "node3:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N3D2"
  "node3:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N3D3"
  "node3:/dev/disk/by-id/nvme-EXAMPLE_SERIAL_N3D4"
)

# Replication (default 3/2: survives loss of one host). 2/1 possible but risky.
POOL_SIZE=3
POOL_MIN_SIZE=2

# --- Production VIP (cephadm ingress: haproxy + keepalived containers) ----------
# Placeholders — fill before ./setup-ingress-vip.sh --apply
VIP_ADDR="10.250.0.10"                   # floating VIP (no CIDR here)
VIP_CIDR="24"                            # combined as VIP_ADDR/VIP_CIDR in the spec
# Network used to pick the NIC for the VIP (usually same as PUBLIC_NETWORK)
VIP_INTERFACE_NETWORK="10.250.0.0/24"
VRRP_INTERFACE_NETWORK=""                # optional; "" = same NIC as VIP
# Ingress images tags (must match offline bundle / Tentacle 20.2.4 defaults)
HAPROXY_TAG="2.3"
KEEPALIVED_TAG="2.2.4"
# backend_service: "mon" for client/CSI-oriented VIP; "rgw.*" / "nfs.*" for those stacks
INGRESS_BACKEND_SERVICE="mon"
INGRESS_SERVICE_ID="mon"
INGRESS_FRONTEND_PORT=3300               # msgr2 when fronting mon; ignored if keepalive_only
INGRESS_MONITOR_PORT=1967                # haproxy stats; ignored if keepalive_only
# 1 = keepalived only (recommended for mon/CSI VIP on Tentacle: stock haproxy mode is HTTP
#     for non-nfs backends and is unsuitable for MON msgr2). 0 = full haproxy+keepalived
#     (use for RGW/NFS backends).
INGRESS_KEEPALIVE_ONLY=1

# CephFS (optional; primary path is RBD — see docs/cephfs-client.md)
FS_NAME="models"
META_POOL="models_meta"
DATA_POOL="models_data"
META_PG=32
DATA_PG=128
MDS_COUNT=2                               # 1 active + 1 standby
CLIENT_RO="modelreader"
CLIENT_RW="modelwriter"

# Extra (testing only): osd_memory_target in bytes, "" = Ceph default (4 GiB)
OSD_MEMORY_TARGET=""

# =====================================================================================
# One-click deploy (./deploy.sh) — fields below are NEW and optional; everything above
# keeps its old meaning, and the per-step scripts still work exactly as before.
# =====================================================================================
# chrony/NTP is assumed already correct on every node: 0 = install-node.sh does not touch
# chrony and validate.sh does not check it. 1 = old behaviour (node1 serves time).
MANAGE_CHRONY=0
# OSD_DEVICES entries may carry an optional class: "node1:/dev/disk/by-id/nvme-X:nvme".
# Every OSD is collocated (data+WAL+DB on the same disk). Only /dev/disk/by-id paths.
OSD_UP_TIMEOUT=900                        # seconds deploy waits for planned OSDs to be up

# Pools
PG_AUTOSCALE="on"                         # on | warn | off (off: pg_num below is final)
TARGET_PG_PER_OSD=100                     # validate.sh fails if PG replicas/OSD > 2.5x this
# RBD pools: "name:pg_num:size:target_size_ratio" (size "" = POOL_SIZE; ratio "" = none)
RBD_POOLS=( "rbd:128:3:0.6" )

# RGW (S3). Hosts get label "rgw"; service = rgw.$RGW_SERVICE_ID
ENABLE_RGW=0
RGW_REALM="default"; RGW_ZONEGROUP="default"; RGW_ZONE="default"
RGW_SERVICE_ID="main"
RGW_HOSTS=(node2 node3)
RGW_PORT=8080                             # radosgw beast port on each RGW host
RGW_DATA_PG=64                            # pg_num for default.rgw.buckets.data (pre-created)
# RGW own VIP via cephadm ingress (haproxy + keepalived, images from local registry)
RGW_INGRESS=0
RGW_VIP=""                                # bare IP, e.g. 10.250.0.20 (must differ from VIP_ADDR)
RGW_VIP_CIDR=24
RGW_VIP_INTERFACE_NETWORK=""              # "" = PUBLIC_NETWORK
RGW_FRONTEND_PORT=80                      # S3 endpoint http://RGW_VIP:RGW_FRONTEND_PORT
RGW_MONITOR_PORT=1968                     # haproxy stats (mon ingress uses 1967)
RGW_VRRP_ROUTER_ID=60                     # keepalived first_virtual_router_id (mon ingress default 50)

# Mon VIP (setup-ingress-vip.sh, VIP_* fields above) during deploy.sh: 1 = apply
ENABLE_MON_VIP=0

# CephFS during deploy.sh: 1 = run setup-cephfs.sh (FS_* fields above)
ENABLE_CEPHFS=0
MDS_HOSTS=()                              # e.g. (node1 node2); () = any MDS_COUNT hosts

# =====================================================================================
# Optional S3 BGP/ECMP entry (docs/s3-bgp.md). OFF by default and NOT part of the default
# deploy.sh run: enable here, then `./deploy.sh --only s3-bgp` (or ./setup-s3-bgp.sh).
# Needs RGW_INGRESS=1 (existing cephadm haproxy+keepalived VIP is kept as-is). Each
# S3_BGP_HOSTS node gets FRR (from the bundle), dummy $S3_BGP_DUMMY holding VIP/32, ARP
# sysctls on $S3_BGP_IFACE only, and a health service that announces VIP/32 to the peer
# only while local HAProxy + RGW are healthy. Switch side is manual: docs/s3-bgp-switch-h3c.md
# =====================================================================================
ENABLE_S3_BGP=0
S3_BGP_HOSTS=()                           # () = RGW_HOSTS (must run ingress haproxy)
S3_BGP_VIP=""                             # "" = RGW_VIP (bare IP, announced as /32)
S3_BGP_LOCAL_ASN=65050                    # node side AS (same on all hosts)
S3_BGP_PEER_IP=""                         # switch/leaf IP on the business subnet, e.g. 10.11.4.1
S3_BGP_PEER_ASN=65000
S3_BGP_ROUTER_IDS=()                      # ("node2=10.11.4.42" ...); () = node IP from NODE_IPS
S3_BGP_IFACE=""                           # business iface; "" = iface holding the node IP
S3_BGP_DUMMY="s3vip0"                     # our dummy iface (<=15 chars, must not exist)
S3_BGP_KEEPALIVE=3; S3_BGP_HOLD=9         # BGP timers (must match switch side)
S3_BGP_PREFIX_LIST="S3VIP"                # FRR prefix-lists <name>-OUT / <name>-IN
# HAProxy discovery: "" = newest match of the glob (cephadm: /var/lib/ceph/<fsid>/haproxy.rgw.<svc>.<host>.<rand>/haproxy/haproxy.cfg)
S3_BGP_HAPROXY_CFG=""
#S3_BGP_HAPROXY_GLOB="/var/lib/ceph/*/haproxy.rgw.main.*/haproxy/haproxy.cfg"
S3_BGP_STATS_URL=""                       # "" = http://<node IP>:RGW_MONITOR_PORT/stats;csv (auth read from haproxy.cfg)
S3_BGP_FRONTEND_NAME="frontend"; S3_BGP_BACKEND_NAME="backend"; S3_BGP_BACKEND_SERVER_PREFIX="rgw."
# Local probe: anon-xml (GET -> 200 + S3_BGP_PROBE_EXPECT) | http-status (code in S3_BGP_PROBE_CODES)
#              | tcp | none.  S3_BGP_PROBE_URL "" = http://<node IP>:RGW_PORT/
S3_BGP_PROBE_MODE="anon-xml"; S3_BGP_PROBE_URL=""
S3_BGP_PROBE_EXPECT="ListAllMyBucketsResult"; S3_BGP_PROBE_CODES="200 403"
S3_BGP_RISE=3; S3_BGP_FALL=2; S3_BGP_INTERVAL=2   # advertise after 3 good, withdraw after 2 bad, poll 2s
S3_BGP_WATCHDOG_SEC=15

# =====================================================================================
# Monitoring + dashboard (deploy.sh stage "monitoring" = setup-monitoring.sh; docs/monitoring.md)
# ON by default. Images come from the node1 local registry (bundle >= oneclick.3).
# Alerts: no webhook/SMTP is configured; metrics are exported for external scraping
# (mgr :9283, ceph-exporter :9926, node-exporter :9100, prometheus :9095, SD :8765).
# =====================================================================================
ENABLE_MONITORING=1                       # ceph-exporter, node-exporter, prometheus, alertmanager, grafana
ENABLE_ALERTMANAGER=1
MONITORING_HOSTS=()                       # prometheus/alertmanager/grafana hosts; () = count:1
PROMETHEUS_RETENTION_TIME="15d"           # y|w|d|h|m|s
PROMETHEUS_RETENTION_SIZE="0"             # 0 = unlimited, e.g. "50GB"
ENABLE_DASHBOARD=1                        # HTTPS on DASHBOARD_PORT
DASHBOARD_PORT=8443
DASHBOARD_CERT=""; DASHBOARD_KEY=""       # both set = own cert (PEM); both "" = self-signed
DASHBOARD_ADMIN_USER="admin"
DASHBOARD_ADMIN_PASSWORD_FILE="/etc/fast-deploy/dashboard-admin.pass"   # generated (600) if missing; never printed
GRAFANA_FRONTEND_API_URL=""               # e.g. "https://10.250.0.11:3000" if browsers need another URL
GRAFANA_API_SSL_VERIFY="False"            # cephadm grafana uses a self-signed cert
GRAFANA_ADMIN_PASSWORD_FILE=""            # optional grafana initial admin password file ("" = anonymous viewer only)
SD_PORT=8765                              # cephadm Prometheus service discovery (http_sd)

# Metadata backup (backup-cluster-meta.sh, manual only -- never run by deploy.sh; docs/backup.md)
BACKUP_DIR="/var/backups/ceph-meta"
