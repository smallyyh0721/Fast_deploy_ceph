! managed-by: fast-deploy-s3-bgp
! Generated by setup-s3-bgp.sh. teardown-s3-bgp.sh restores the previous file.
! No "network" statement on purpose: s3-bgp-health.service adds/removes @VIP@/32 at runtime.
frr defaults traditional
hostname @HOSTNAME@
log syslog informational
service integrated-vtysh-config
!
ip prefix-list @PL@-OUT seq 10 permit @VIP@/32
ip prefix-list @PL@-OUT seq 100 deny 0.0.0.0/0 le 32
ip prefix-list @PL@-IN seq 10 deny 0.0.0.0/0 le 32
!
router bgp @LOCAL_ASN@
 bgp router-id @ROUTER_ID@
 bgp ebgp-requires-policy
 bgp network import-check
 no bgp default ipv4-unicast
 neighbor @PEER_IP@ remote-as @PEER_ASN@
 neighbor @PEER_IP@ timers @KEEPALIVE@ @HOLD@
 address-family ipv4 unicast
  neighbor @PEER_IP@ activate
  neighbor @PEER_IP@ prefix-list @PL@-IN in
  neighbor @PEER_IP@ prefix-list @PL@-OUT out
 exit-address-family
!
